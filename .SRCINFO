	license = MIT
	checkdepends = shellcheck
	makedepends = git
	makedepends = go
	depends = bash
	depends = coreutils
	depends = gawk
	depends = grep
	depends = pacman
	depends = pam
	depends = procps-ng
	depends = sed
	depends = sudo
	depends = systemd
	depends = util-linux
	optdepends = gcc: compile the optional U2F enrollment verifier
	optdepends = iw: inspect and configure wireless regulatory domains
	optdepends = libfido2: detect connected FIDO2/U2F authenticators
	optdepends = networkmanager: apply NetworkManager-specific power settings
	optdepends = pam-u2f: enable U2F authentication
	optdepends = pciutils: hardware detection and eGPU diagnostics
	optdepends = snapper: automatic and manual system snapshots
